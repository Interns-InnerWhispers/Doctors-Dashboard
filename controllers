const bcrypt = require('bcryptjs');
const jwt = require('jsonwebtoken');
const db = require('./config/db');

const authController = {
  register: async (req, res) => {
    res.status(200).json({ success: true, message: 'authController.register: skeleton endpoint' });
  },
  
  login: async (req, res) => {
    const { email, password } = req.body;
    if (!email || !password) {
      return res.status(400).json({ success: false, message: 'Please provide email and password.' });
    }

    try {
      const [users] = await db.query('SELECT * FROM doctors WHERE email = ?', [email]);
      if (!users || users.length === 0) {
        return res.status(401).json({ success: false, message: 'Invalid email or password.' });
      }

      const user = users[0];
      const isMatch = await bcrypt.compare(password, user.password_hash);
      if (!isMatch) {
        return res.status(401).json({ success: false, message: 'Invalid email or password.' });
      }

      const token = jwt.sign(
        { id: user.doctor_id, email: user.email, role: 'doctor' },
        process.env.JWT_SECRET || 'fallback_secret',
        { expiresIn: '7d' }
      );

      res.status(200).json({
        success: true,
        message: 'Logged in successfully.',
        token,
        user: { id: user.doctor_id, name: user.name, email: user.email, role: 'doctor' }
      });
    } catch (error) {
      console.error('Login error:', error.message);
      res.status(500).json({ success: false, message: 'Internal server error during login.' });
    }
  },

  logout: async (req, res) => {
    res.status(200).json({
      success: true,
      message: 'Logged out successfully. Please discard the authentication token on the client side.'
    });
  },

  getProfile: async (req, res) => {
    try {
      const [users] = await db.query('SELECT doctor_id, name, email, specialization, profile_image, created_at FROM doctors WHERE doctor_id = ?', [req.user.id]);
      if (!users || users.length === 0) {
        return res.status(404).json({ success: false, message: 'User profile not found.' });
      }
      res.status(200).json({ success: true, user: users[0] });
    } catch (error) {
      console.error('Get profile error:', error.message);
      res.status(500).json({ success: false, message: 'Internal server error retrieving user profile.' });
    }
  }
};

const doctorController = {
  getDoctors: async (req, res) => {
    const { specialty } = req.query;
    try {
      let query = 'SELECT doctor_id, name, email, specialization, profile_image, created_at FROM doctors';
      const params = [];
      if (specialty) {
        query += ' WHERE specialization = ?';
        params.push(specialty);
      }
      const [doctors] = await db.query(query, params);
      res.status(200).json({ success: true, doctors });
    } catch (error) {
      console.error('Get doctors error:', error.message);
      res.status(500).json({ success: false, message: 'Internal server error retrieving doctors.' });
    }
  },
  
  getDoctorById: async (req, res) => {
    const { id } = req.params;
    try {
      const [doctors] = await db.query('SELECT doctor_id, name, email, specialization, profile_image, created_at FROM doctors WHERE doctor_id = ?', [id]);
      if (!doctors || doctors.length === 0) {
        return res.status(404).json({ success: false, message: 'Doctor not found.' });
      }
      res.status(200).json({ success: true, doctor: doctors[0] });
    } catch (error) {
      console.error('Get doctor by id error:', error.message);
      res.status(500).json({ success: false, message: 'Internal server error retrieving doctor.' });
    }
  },
  
  updateDoctorProfile: async (req, res) => {
    const { name, specialization, profile_image } = req.body;
    const doctorId = req.user.id;
    try {
      await db.query(
        'UPDATE doctors SET name = ?, specialization = ?, profile_image = ? WHERE doctor_id = ?',
        [name, specialization, profile_image, doctorId]
      );
      res.status(200).json({ success: true, message: 'Doctor profile updated successfully.' });
    } catch (error) {
      console.error('Update doctor profile error:', error.message);
      res.status(500).json({ success: false, message: 'Internal server error updating doctor profile.' });
    }
  }
};

const patientController = {
  getPatients: async (req, res) => {
    try {
      const [patients] = await db.query('SELECT patient_id, doctor_id, name, dob, gender, phone, email, diagnosis, status, created_at FROM patients');
      res.status(200).json({ success: true, patients });
    } catch (error) {
      console.error('Get patients error:', error.message);
      res.status(500).json({ success: false, message: 'Internal server error retrieving patients.' });
    }
  },
  
  getPatientById: async (req, res) => {
    const { id } = req.params;
    try {
      const [patients] = await db.query('SELECT patient_id, doctor_id, name, dob, gender, phone, email, diagnosis, status, created_at FROM patients WHERE patient_id = ?', [id]);
      if (!patients || patients.length === 0) {
        return res.status(404).json({ success: false, message: 'Patient not found.' });
      }
      res.status(200).json({ success: true, patient: patients[0] });
    } catch (error) {
      console.error('Get patient by id error:', error.message);
      res.status(500).json({ success: false, message: 'Internal server error retrieving patient.' });
    }
  },
  
  upsertPatientProfile: async (req, res) => {
    const { patient_id, name, dob, gender, phone, email, diagnosis, status } = req.body;
    const doctorId = req.user.id;
    try {
      if (patient_id) {
        await db.query(
          'UPDATE patients SET name = ?, dob = ?, gender = ?, phone = ?, email = ?, diagnosis = ?, status = ? WHERE patient_id = ? AND doctor_id = ?',
          [name, dob, gender, phone, email, diagnosis, status, patient_id, doctorId]
        );
        res.status(200).json({ success: true, message: 'Patient profile updated successfully.' });
      } else {
        await db.query(
          'INSERT INTO patients (doctor_id, name, dob, gender, phone, email, diagnosis, status) VALUES (?, ?, ?, ?, ?, ?, ?, ?)',
          [doctorId, name, dob, gender, phone, email, diagnosis, status]
        );
        res.status(201).json({ success: true, message: 'Patient profile created successfully.' });
      }
    } catch (error) {
      console.error('Upsert patient profile error:', error.message);
      res.status(500).json({ success: false, message: 'Internal server error updating patient profile.' });
    }
  }
};

module.exports = {
  authController,
  doctorController,
  patientController
};
