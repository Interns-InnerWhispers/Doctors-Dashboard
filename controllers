const { supabaseAdmin, createSupabaseClient } = require('./config/supabase');

const authController = {
  register: async (req, res) => {
    const { name, email, password, specialization, profile_image } = req.body;
    if (!name || !email || !password || !specialization) {
      return res.status(400).json({
        success: false,
        message: 'Please provide name, email, password, and specialization.'
      });
    }

    try {
      // 1. Sign up the user in Supabase Auth
      const { data, error } = await supabaseAdmin.auth.signUp({
        email,
        password,
        options: {
          data: {
            name,
            specialization,
            profile_image
          }
        }
      });

      if (error) {
        return res.status(400).json({ success: false, message: error.message });
      }

      if (!data.user) {
        return res.status(400).json({ success: false, message: 'Failed to create user in authentication service.' });
      }

      // 2. Save the doctor in Supabase public.doctors table mapped to the Supabase UID
      const { data: newDoctor, error: insertError } = await supabaseAdmin
        .from('doctors')
        .insert([{
          supabase_uid: data.user.id,
          name,
          email,
          specialization,
          profile_image: profile_image || null
        }])
        .select();

      if (insertError) throw insertError;
      const result = newDoctor[0];

      res.status(201).json({
        success: true,
        message: 'Doctor registered successfully.',
        user: {
          id: result.doctor_id,
          supabase_uid: data.user.id,
          name,
          email,
          specialization,
          profile_image: profile_image || null,
          role: 'doctor'
        }
      });
    } catch (error) {
      console.error('Registration error:', error.message);
      res.status(500).json({ success: false, message: 'Internal server error during registration.' });
    }
  },
  
  login: async (req, res) => {
    const { email, password } = req.body;
    if (!email || !password) {
      return res.status(400).json({ success: false, message: 'Please provide email and password.' });
    }

    try {
      // 1. Sign in with Supabase Auth
      const { data, error } = await supabaseAdmin.auth.signInWithPassword({
        email,
        password
      });

      if (error) {
        return res.status(401).json({ success: false, message: error.message });
      }

      if (!data.session || !data.user) {
        return res.status(401).json({ success: false, message: 'Authentication failed: No active session.' });
      }

      // 2. Fetch the local doctor details using supabase_uid
      let { data: doctors, error: fetchError } = await supabaseAdmin
        .from('doctors')
        .select('*')
        .eq('supabase_uid', data.user.id);
        
      let doctor = doctors && doctors.length > 0 ? doctors[0] : null;

      // Fallback: search by email if local record exists but doesn't have supabase_uid linked yet
      if (!doctor) {
        let { data: doctorsByEmail } = await supabaseAdmin
          .from('doctors')
          .select('*')
          .eq('email', email);
          
        if (doctorsByEmail && doctorsByEmail.length > 0) {
          doctor = doctorsByEmail[0];
          await supabaseAdmin
            .from('doctors')
            .update({ supabase_uid: data.user.id })
            .eq('doctor_id', doctor.doctor_id);
        } else {
          // Auto-provision Postgres record if it exists in Supabase Auth but not in public.doctors
          const name = data.user.user_metadata?.name || 'Doctor';
          const specialization = data.user.user_metadata?.specialization || 'General Practice';
          const profile_image = data.user.user_metadata?.profile_image || null;

          const { data: newDoctors, error: insertError } = await supabaseAdmin
            .from('doctors')
            .insert([{
              supabase_uid: data.user.id,
              name,
              email,
              specialization,
              profile_image
            }])
            .select();
            
          if (insertError) throw insertError;
          doctor = newDoctors[0];
        }
      }

      res.status(200).json({
        success: true,
        message: 'Logged in successfully.',
        token: data.session.access_token,
        user: {
          id: doctor.doctor_id,
          supabase_uid: data.user.id,
          name: doctor.name,
          email: doctor.email,
          specialization: doctor.specialization,
          profile_image: doctor.profile_image,
          role: 'doctor'
        }
      });
    } catch (error) {
      console.error('Login error:', error.message);
      res.status(500).json({ success: false, message: 'Internal server error during login.' });
    }
  },

  logout: async (req, res) => {
    res.status(200).json({
      success: true,
      message: 'Logged out successfully. Please discard the authentication token on the client side.'
    });
  },

  getProfile: async (req, res) => {
    try {
      const { data: users, error } = await req.supabase
        .from('doctors')
        .select('doctor_id, supabase_uid, name, email, specialization, profile_image, created_at')
        .eq('doctor_id', req.user.id);
        
      if (error) throw error;
      
      if (!users || users.length === 0) {
        return res.status(404).json({ success: false, message: 'User profile not found.' });
      }
      res.status(200).json({ success: true, user: users[0] });
    } catch (error) {
      console.error('Get profile error:', error.message);
      res.status(500).json({ success: false, message: 'Internal server error retrieving user profile.' });
    }
  }
};

const doctorController = {
  getDoctors: async (req, res) => {
    const { specialty } = req.query;
    try {
      const supabase = req.supabase || createSupabaseClient();
      let query = supabase
        .from('doctors')
        .select('doctor_id, name, email, specialization, profile_image, created_at');
        
      if (specialty) {
        query = query.eq('specialization', specialty);
      }
      
      const { data: doctors, error } = await query;
      
      if (error) throw error;
      res.status(200).json({ success: true, doctors });
    } catch (error) {
      console.error('Get doctors error:', error.message);
      res.status(500).json({ success: false, message: 'Internal server error retrieving doctors.', error: error.message, stack: error.stack });
    }
  },
  
  getDoctorById: async (req, res) => {
    const { id } = req.params;
    try {
      const supabase = req.supabase || createSupabaseClient();
      const { data: doctors, error } = await supabase
        .from('doctors')
        .select('doctor_id, name, email, specialization, profile_image, created_at')
        .eq('doctor_id', id);
        
      if (error) throw error;
      
      if (!doctors || doctors.length === 0) {
        return res.status(404).json({ success: false, message: 'Doctor not found.' });
      }
      res.status(200).json({ success: true, doctor: doctors[0] });
    } catch (error) {
      console.error('Get doctor by id error:', error.message);
      res.status(500).json({ success: false, message: 'Internal server error retrieving doctor.' });
    }
  },
  
  updateDoctorProfile: async (req, res) => {
    const { name, specialization, profile_image } = req.body;
    const doctorId = req.user.id;
    try {
      const { error } = await req.supabase
        .from('doctors')
        .update({ name, specialization, profile_image })
        .eq('doctor_id', doctorId);
        
      if (error) throw error;
      
      res.status(200).json({ success: true, message: 'Doctor profile updated successfully.' });
    } catch (error) {
      console.error('Update doctor profile error:', error.message);
      res.status(500).json({ success: false, message: 'Internal server error updating doctor profile.' });
    }
  }
};

const patientController = {
  getPatients: async (req, res) => {
    try {
      const doctorId = req.user.id;
      let { page, limit, name, status } = req.query;

      // Pagination defaults
      page = parseInt(page, 10) || 1;
      limit = parseInt(limit, 10) || 10;
      const offset = (page - 1) * limit;

      let query = req.supabase
        .from('patients')
        .select('*', { count: 'exact' })
        .eq('doctor_id', doctorId)
        .neq('status', 'deleted');

      if (name) {
        query = query.ilike('name', `%${name}%`);
      }
      if (status) {
        query = query.eq('status', status);
      }

      const { data: patients, count: totalPatients, error } = await query
        .order('created_at', { ascending: false })
        .range(offset, offset + limit - 1);

      if (error) throw error;

      res.status(200).json({ 
        success: true, 
        patients,
        pagination: {
          total: totalPatients || 0,
          page,
          limit,
          totalPages: Math.ceil((totalPatients || 0) / limit)
        }
      });
    } catch (error) {
      console.error('Get patients error:', error.message);
      res.status(500).json({ success: false, message: 'Internal server error retrieving patients.' });
    }
  },
  
  getPatientById: async (req, res) => {
    const { id } = req.params;
    try {
      const { data: patients, error } = await req.supabase
        .from('patients')
        .select('*')
        .eq('patient_id', id);
        
      if (error) throw error;
      
      if (!patients || patients.length === 0) {
        return res.status(404).json({ success: false, message: 'Patient not found.' });
      }
      res.status(200).json({ success: true, patient: patients[0] });
    } catch (error) {
      console.error('Get patient by id error:', error.message);
      res.status(500).json({ success: false, message: 'Internal server error retrieving patient.' });
    }
  },
  
  createPatient: async (req, res) => {
    const { name, dob, gender, phone, email, diagnosis, status } = req.body;
    const doctorId = req.user.id;

    // Validation
    if (!name || typeof name !== 'string' || name.trim() === '') {
      return res.status(400).json({ success: false, message: 'Patient name is required and must be a valid string.' });
    }
    
    // Default status if not provided
    const patientStatus = status || 'Active';

    try {
      const { data: newPatient, error } = await req.supabase
        .from('patients')
        .insert([{
          doctor_id: doctorId,
          name: name.trim(),
          dob: dob || null,
          gender: gender || null,
          phone: phone || null,
          email: email || null,
          diagnosis: diagnosis || null,
          status: patientStatus
        }])
        .select();

      if (error) throw error;

      res.status(201).json({ 
        success: true, 
        message: 'Patient created successfully.',
        patient: newPatient[0]
      });
    } catch (error) {
      console.error('Create patient error:', error.message);
      res.status(500).json({ success: false, message: 'Internal server error creating patient.' });
    }
  },
  
  upsertPatientProfile: async (req, res) => {
    const { patient_id, name, dob, gender, phone, email, diagnosis, status } = req.body;
    const doctorId = req.user.id;
    try {
      if (patient_id) {
        const { error } = await req.supabase
          .from('patients')
          .update({ name, dob, gender, phone, email, diagnosis, status })
          .eq('patient_id', patient_id)
          .eq('doctor_id', doctorId);
          
        if (error) throw error;
        res.status(200).json({ success: true, message: 'Patient profile updated successfully.' });
      } else {
        const { error } = await req.supabase
          .from('patients')
          .insert([{ doctor_id: doctorId, name, dob, gender, phone, email, diagnosis, status }]);
          
        if (error) throw error;
        res.status(201).json({ success: true, message: 'Patient profile created successfully.' });
      }
    } catch (error) {
      console.error('Upsert patient profile error:', error.message);
      res.status(500).json({ success: false, message: 'Internal server error updating patient profile.' });
    }
  },
  
  updatePatientById: async (req, res) => {
    const { id } = req.params;
    const { name, dob, gender, phone, email, diagnosis, status } = req.body;
    const doctorId = req.user.id;

    if (!name) {
      return res.status(400).json({ success: false, message: 'Patient name is required.' });
    }

    try {
      const { data, error } = await req.supabase
        .from('patients')
        .update({ name, dob, gender, phone, email, diagnosis, status })
        .eq('patient_id', id)
        .eq('doctor_id', doctorId)
        .select();

      if (error) throw error;

      if (!data || data.length === 0) {
        return res.status(404).json({ success: false, message: 'Patient not found or you do not have permission to update.' });
      }

      res.status(200).json({ success: true, message: 'Patient profile updated successfully.' });
    } catch (error) {
      console.error('Update patient by id error:', error.message);
      res.status(500).json({ success: false, message: 'Internal server error updating patient profile.' });
    }
  },
  
  deletePatientById: async (req, res) => {
    const { id } = req.params;
    const doctorId = req.user.id;

    try {
      const { data, error } = await req.supabase
        .from('patients')
        .update({ status: 'deleted' })
        .eq('patient_id', id)
        .eq('doctor_id', doctorId)
        .select();

      if (error) throw error;

      if (!data || data.length === 0) {
        return res.status(404).json({ success: false, message: 'Patient not found or you do not have permission to delete.' });
      }

      res.status(200).json({ success: true, message: 'Patient deleted successfully.' });
    } catch (error) {
      console.error('Delete patient by id error:', error.message);
      res.status(500).json({ success: false, message: 'Internal server error deleting patient.' });
    }
  }
};


const appointmentController = {
  getAppointments: async (req, res) => {
    const doctorId = req.user.id;
    const { patient_id, date, status } = req.query;

    try {
      let query = req.supabase
        .from('appointments')
        .select('appt_id, doctor_id, patient_id, date, time, type, status, notes, created_at')
        .eq('doctor_id', doctorId);

      if (patient_id) {
        query = query.eq('patient_id', patient_id);
      }

      if (date) {
        query = query.eq('date', date);
      }

      if (status) {
        query = query.eq('status', status);
      }

      const { data: appointments, error } = await query
        .order('date', { ascending: false })
        .order('time', { ascending: false });

      if (error) throw error;

      res.status(200).json({
        success: true,
        appointments
      });
    } catch (error) {
      console.error('Get appointments error:', error.message);
      res.status(500).json({
        success: false,
        message: 'Internal server error retrieving appointments.'
      });
    }
  },
  
  createAppointment: async (req, res) => {
    const doctorId = req.user.id;
    const { patient_id, date, time, type, status, notes } = req.body;

    if (!patient_id || !date || !time) {
      return res.status(400).json({ success: false, message: 'patient_id, date, and time are required.' });
    }

    try {
      const { data: newAppointment, error } = await req.supabase
        .from('appointments')
        .insert([{
          doctor_id: doctorId,
          patient_id,
          date,
          time,
          type: type || null,
          status: status || 'scheduled',
          notes: notes || null
        }])
        .select();

      if (error) throw error;

      res.status(201).json({ 
        success: true, 
        message: 'Appointment created successfully.',
        appointment: newAppointment[0] 
      });
    } catch (error) {
      console.error('Create appointment error:', error.message);
      res.status(500).json({ success: false, message: 'Internal server error creating appointment.' });
    }
  }
};


