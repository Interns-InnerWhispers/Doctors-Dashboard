const patientController = {
  getPatients: async (req, res) => {
    try {
      const doctorId = req.user.id;
      let { page, limit, name, status } = req.query;

      // Pagination defaults
      page = parseInt(page, 10) || 1;
      limit = parseInt(limit, 10) || 10;
      const offset = (page - 1) * limit;

      let query = req.supabase
        .from('patients')
        .select('*', { count: 'exact' })
        .eq('doctor_id', doctorId)
        .neq('status', 'deleted');

      if (name) {
        query = query.ilike('name', `%${name}%`);
      }
      if (status) {
        query = query.eq('status', status);
      }

      const { data: patients, count: totalPatients, error } = await query
        .order('created_at', { ascending: false })
        .range(offset, offset + limit - 1);

      if (error) throw error;

      res.status(200).json({ 
        success: true, 
        patients,
        pagination: {
          total: totalPatients || 0,
          page,
          limit,
          totalPages: Math.ceil((totalPatients || 0) / limit)
        }
      });
    } catch (error) {
      console.error('Get patients error:', error.message);
      res.status(500).json({ success: false, message: 'Internal server error retrieving patients.' });
    }
  },
  
  getPatientById: async (req, res) => {
    const { id } = req.params;
    try {
      const { data: patients, error } = await req.supabase
        .from('patients')
        .select('*')
        .eq('patient_id', id);
        
      if (error) throw error;
      
      if (!patients || patients.length === 0) {
        return res.status(404).json({ success: false, message: 'Patient not found.' });
      }
      res.status(200).json({ success: true, patient: patients[0] });
    } catch (error) {
      console.error('Get patient by id error:', error.message);
      res.status(500).json({ success: false, message: 'Internal server error retrieving patient.' });
    }
  },
  
  createPatient: async (req, res) => {
    const { name, dob, gender, phone, email, diagnosis, status } = req.body;
    const doctorId = req.user.id;

    // Validation
    if (!name || typeof name !== 'string' || name.trim() === '') {
      return res.status(400).json({ success: false, message: 'Patient name is required and must be a valid string.' });
    }
    
    // Default status if not provided
    const patientStatus = status || 'Active';

    try {
      const { data: newPatient, error } = await req.supabase
        .from('patients')
        .insert([{
          doctor_id: doctorId,
          name: name.trim(),
          dob: dob || null,
          gender: gender || null,
          phone: phone || null,
          email: email || null,
          diagnosis: diagnosis || null,
          status: patientStatus
        }])
        .select();

      if (error) throw error;

      res.status(201).json({ 
        success: true, 
        message: 'Patient created successfully.',
        patient: newPatient[0]
      });
    } catch (error) {
      console.error('Create patient error:', error.message);
      res.status(500).json({ success: false, message: 'Internal server error creating patient.' });
    }
  },
  
  upsertPatientProfile: async (req, res) => {
    const { patient_id, name, dob, gender, phone, email, diagnosis, status } = req.body;
    const doctorId = req.user.id;
    try {
      if (patient_id) {
        const { error } = await req.supabase
          .from('patients')
          .update({ name, dob, gender, phone, email, diagnosis, status })
          .eq('patient_id', patient_id)
          .eq('doctor_id', doctorId);
          
        if (error) throw error;
        res.status(200).json({ success: true, message: 'Patient profile updated successfully.' });
