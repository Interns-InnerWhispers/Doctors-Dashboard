const authController = {
  register: async (req, res) => {
    const { name, email, password, specialization, profile_image } = req.body;
    if (!name || !email || !password || !specialization) {
      return res.status(400).json({
        success: false,
        message: 'Please provide name, email, password, and specialization.'
      });
    }

    try {
      // 1. Sign up the user in Supabase Auth using a clean client to avoid session pollution
      const tempClient = createClient(
        supabaseUrl || 'https://placeholder-project-url.supabase.co',
        supabaseAnonKey || 'placeholder-anon-key',
        { auth: { persistSession: false, autoRefreshToken: false } }
      );
      const { data, error } = await tempClient.auth.signUp({
        email,
        password,
        options: {
          data: {
            name,
            specialization,
            profile_image
          }
        }
      });

      if (error) {
        return res.status(400).json({ success: false, message: error.message });
      }

      if (!data.user) {
        return res.status(400).json({ success: false, message: 'Failed to create user in authentication service.' });
      }

      // 2. Save the doctor in Supabase public.doctors table mapped to the Supabase UID
      const { data: newDoctor, error: insertError } = await supabaseAdmin
        .from('doctors')
        .insert([{
          supabase_uid: data.user.id,
          name,
          email,
          specialization,
          profile_image: profile_image || null
        }])
        .select();

      if (insertError) throw insertError;
      const result = newDoctor[0];

      res.status(201).json({
        success: true,
        message: 'Doctor registered successfully.',
        user: {
          id: result.doctor_id,
          supabase_uid: data.user.id,
          name,
          email,
          specialization,
          profile_image: profile_image || null,
          role: 'doctor'
        }
      });
    } catch (error) {
      console.error('Registration error:', error.message);
      res.status(500).json({ success: false, message: 'Internal server error during registration.' });
    }
  },
  
  login: async (req, res) => {
    const { email, password } = req.body;
    if (!email || !password) {
      return res.status(400).json({ success: false, message: 'Please provide email and password.' });
    }

    try {
      // 1. Sign in with Supabase Auth using a clean client to avoid session pollution
      const tempClient = createClient(
        supabaseUrl || 'https://placeholder-project-url.supabase.co',
        supabaseAnonKey || 'placeholder-anon-key',
        { auth: { persistSession: false, autoRefreshToken: false } }
      );
      const { data, error } = await tempClient.auth.signInWithPassword({
        email,
        password
      });

      if (error) {
        return res.status(401).json({ success: false, message: error.message });
      }

      if (!data.session || !data.user) {
        return res.status(401).json({ success: false, message: 'Authentication failed: No active session.' });
      }

      // 2. Fetch the local doctor details using supabase_uid
      let { data: doctors, error: fetchError } = await supabaseAdmin
        .from('doctors')
        .select('*')
        .eq('supabase_uid', data.user.id);
        
      let doctor = doctors && doctors.length > 0 ? doctors[0] : null;

      // Fallback: search by email if local record exists but doesn't have supabase_uid linked yet
      if (!doctor) {
        let { data: doctorsByEmail } = await supabaseAdmin
          .from('doctors')
          .select('*')
          .eq('email', email);
          
        if (doctorsByEmail && doctorsByEmail.length > 0) {
          doctor = doctorsByEmail[0];
          await supabaseAdmin
            .from('doctors')
            .update({ supabase_uid: data.user.id })
            .eq('doctor_id', doctor.doctor_id);
        } else {
          // Auto-provision Postgres record if it exists in Supabase Auth but not in public.doctors
          const name = data.user.user_metadata?.name || 'Doctor';
          const specialization = data.user.user_metadata?.specialization || 'General Practice';
          const profile_image = data.user.user_metadata?.profile_image || null;

          const { data: newDoctors, error: insertError } = await supabaseAdmin
            .from('doctors')
            .insert([{
              supabase_uid: data.user.id,
              name,
              email,
              specialization,
              profile_image
            }])
            .select();
            
          if (insertError) throw insertError;
          doctor = newDoctors[0];
        }
      }

      res.status(200).json({
        success: true,
        message: 'Logged in successfully.',
        token: data.session.access_token,
        user: {
          id: doctor.doctor_id,
          supabase_uid: data.user.id,
          name: doctor.name,
          email: doctor.email,
          specialization: doctor.specialization,
          profile_image: doctor.profile_image,
          role: 'doctor'
        }
      });
    } catch (error) {
      console.error('Login error:', error.message);
      res.status(500).json({ success: false, message: 'Internal server error during login.' });
    }
  },

  logout: async (req, res) => {
    res.status(200).json({
      success: true,
      message: 'Logged out successfully. Please discard the authentication token on the client side.'
    });
  },

  getProfile: async (req, res) => {
    try {
      const { data: users, error } = await req.supabase
        .from('doctors')
        .select('doctor_id, supabase_uid, name, email, specialization, profile_image, created_at')
        .eq('doctor_id', req.user.id);
        
      if (error) throw error;
      
      if (!users || users.length === 0) {
        return res.status(404).json({ success: false, message: 'User profile not found.' });
      }
      res.status(200).json({ success: true, user: users[0] });
    } catch (error) {
      console.error('Get profile error:', error.message);
      res.status(500).json({ success: false, message: 'Internal server error retrieving user profile.' });
    }
  }
};

