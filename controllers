    const { patient_id, name, dob, gender, phone, email, diagnosis, status } = req.body;
    const doctorId = req.user.id;
    try {
      if (patient_id) {
        await db.query(
          'UPDATE patients SET name = ?, dob = ?, gender = ?, phone = ?, email = ?, diagnosis = ?, status = ? WHERE patient_id = ? AND doctor_id = ?',
          [name, dob, gender, phone, email, diagnosis, status, patient_id, doctorId]
        );
        res.status(200).json({ success: true, message: 'Patient profile updated successfully.' });
      } else {
        await db.query(
          'INSERT INTO patients (doctor_id, name, dob, gender, phone, email, diagnosis, status) VALUES (?, ?, ?, ?, ?, ?, ?, ?)',
          [doctorId, name, dob, gender, phone, email, diagnosis, status]
        );
        res.status(201).json({ success: true, message: 'Patient profile created successfully.' });
      }
    } catch (error) {
      console.error('Upsert patient profile error:', error.message);
      res.status(500).json({ success: false, message: 'Internal server error updating patient profile.' });
    }
  }
};


const appointmentController = {
  getAppointments: async (req, res) => {
    const doctorId = req.user.id;
    const { patient_id, date, status } = req.query;

    try {
      let query =
        'SELECT appt_id, doctor_id, patient_id, date, time, type, status, notes, created_at FROM appointments WHERE doctor_id = ?';

      const params = [doctorId];

      if (patient_id) {
        query += ' AND patient_id = ?';
        params.push(patient_id);
      }

      if (date) {
        query += ' AND date = ?';
        params.push(date);
      }

      if (status) {
        query += ' AND status = ?';
        params.push(status);
      }

      query += ' ORDER BY date DESC, time DESC';

      const [appointments] = await db.query(query, params);

      res.status(200).json({
        success: true,
        appointments
      });
    } catch (error) {
      console.error('Get appointments error:', error.message);
      res.status(500).json({
        success: false,
        message: 'Internal server error retrieving appointments.'
      });
    }
  },
  
  createAppointment: async (req, res) => {
    const doctorId = req.user.id;
    const { patient_id, date, time, type, status, notes } = req.body;

    if (!patient_id || !date || !time) {
      return res.status(400).json({ success: false, message: 'patient_id, date, and time are required.' });
    }

    try {
      const [result] = await db.query(
        'INSERT INTO appointments (doctor_id, patient_id, date, time, type, status, notes) VALUES (?, ?, ?, ?, ?, ?, ?)',
        [doctorId, patient_id, date, time, type || null, status || 'scheduled', notes || null]
      );
      
      const newAppointmentId = result.insertId;
      const [newAppointment] = await db.query('SELECT * FROM appointments WHERE appt_id = ?', [newAppointmentId]);

      res.status(201).json({ 
        success: true, 
        message: 'Appointment created successfully.',
        appointment: newAppointment[0] 
      });
    } catch (error) {
      console.error('Create appointment error:', error.message);
      res.status(500).json({ success: false, message: 'Internal server error creating appointment.' });
    }
  }
};

