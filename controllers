  createReport: async (req, res) => {
    const doctorId = req.user.id;
    const { patient_id, report_title, report_content, ai_draft, pdf_url, status } = req.body;

    if (!patient_id || !report_title) {
      return res.status(400).json({ success: false, message: 'patient_id and report_title are required.' });
    }

    try {
      const { data, error } = await req.supabase
        .from('reports')
        .insert([{
          doctor_id: doctorId,
          patient_id,
          report_title,
          report_content: report_content || null,
          ai_draft: ai_draft || null,
          pdf_url: pdf_url || null,
          status: status || 'draft'
        }])
        .select();

      if (error) throw error;

      res.status(201).json({
        success: true,
        message: 'Report created successfully.',
        report: data[0]
      });
    } catch (error) {
      console.error('Create report error:', error.message);
      res.status(500).json({ success: false, message: 'Failed to create report.' });
    }
  },

  uploadReport: async (req, res) => {
    const doctorId = req.user.id;
    try {
      if (!req.file) {
        return res.status(400).json({ success: false, message: 'No file uploaded.' });
      }

      const { report_id } = req.body;
      if (!report_id) {
        return res.status(400).json({ success: false, message: 'report_id is required.' });
      }

      // Verify report belongs to this doctor
      const { data: existing, error: fetchError } = await req.supabase
        .from('reports')
        .select('report_id')
        .eq('report_id', report_id)
        .eq('doctor_id', doctorId);

      if (fetchError) throw fetchError;
      if (!existing || existing.length === 0) {
        return res.status(404).json({ success: false, message: 'Report not found or you do not have permission.' });
      }

      const uploadResult = await new Promise((resolve, reject) => {
        const uploadStream = cloudinary.uploader.upload_stream(
          { folder: 'doctor_reports' },
          (error, result) => {
            if (error) return reject(error);
            resolve(result);
          }
        );
        streamifier.createReadStream(req.file.buffer).pipe(uploadStream);
      });

      const { data, error } = await req.supabase
        .from('reports')
        .update({ pdf_url: uploadResult.secure_url })
        .eq('report_id', report_id)
        .eq('doctor_id', doctorId)
        .select();

      if (error) throw error;

      res.status(200).json({
        success: true,
        message: 'Report uploaded successfully.',
        report: data[0]
      });
    } catch (error) {
      console.error('Upload report error:', error.message);
      res.status(500).json({ success: false, message: 'Failed to upload report.' });
    }
  },

  updateReport: async (req, res) => {
    const doctorId = req.user.id;
    const { id } = req.params;
    const { report_title, report_content, ai_draft, pdf_url, status } = req.body;

    try {
      const { data, error } = await req.supabase
        .from('reports')
        .update({ report_title, report_content, ai_draft, pdf_url, status })
        .eq('report_id', id)
        .eq('doctor_id', doctorId)
        .select();

      if (error) throw error;

      if (!data || data.length === 0) {
        return res.status(404).json({ success: false, message: 'Report not found or you do not have permission.' });
      }

      res.status(200).json({
        success: true,
        message: 'Report updated successfully.',
        report: data[0]
      });
    } catch (error) {
      console.error('Update report error:', error.message);
      res.status(500).json({ success: false, message: 'Failed to update report.' });
    }
  },

  deleteReport: async (req, res) => {
