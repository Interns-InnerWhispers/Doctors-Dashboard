const patientController = {
  getPatients: async (req, res) => {
    try {
      const doctorId = req.user.id;
      let { page, limit, name, status } = req.query;

      // Pagination defaults
      page = parseInt(page, 10) || 1;
      limit = parseInt(limit, 10) || 10;
      const offset = (page - 1) * limit;

      // Base query
      let baseQuery = "FROM patients WHERE doctor_id = ? AND (status != 'deleted' OR status IS NULL)";
      const queryParams = [doctorId];

      // Filters
      if (name) {
        baseQuery += " AND name LIKE ?";
        queryParams.push(`%${name}%`);
      }
      if (status) {
        baseQuery += " AND status = ?";
        queryParams.push(status);
      }

      // Count total records for pagination metadata
      const [countResult] = await db.query(`SELECT COUNT(*) as total ${baseQuery}`, queryParams);
      const totalPatients = countResult[0].total;

      // Fetch paginated data
      const query = `SELECT patient_id, doctor_id, name, dob, gender, phone, email, diagnosis, status, created_at ${baseQuery} ORDER BY created_at DESC LIMIT ? OFFSET ?`;
      queryParams.push(limit, offset);

      const [patients] = await db.query(query, queryParams);

      res.status(200).json({ 
        success: true, 
        patients,
        pagination: {
          total: totalPatients,
          page,
          limit,
          totalPages: Math.ceil(totalPatients / limit)
        }
      });
    } catch (error) {
      console.error('Get patients error:', error.message);
      res.status(500).json({ success: false, message: 'Internal server error retrieving patients.' });
    }
  },
  
  getPatientById: async (req, res) => {
    const { id } = req.params;
    try {
      const [patients] = await db.query('SELECT patient_id, doctor_id, name, dob, gender, phone, email, diagnosis, status, created_at FROM patients WHERE patient_id = ?', [id]);
      if (!patients || patients.length === 0) {
        return res.status(404).json({ success: false, message: 'Patient not found.' });
      }
      res.status(200).json({ success: true, patient: patients[0] });
    } catch (error) {
      console.error('Get patient by id error:', error.message);
      res.status(500).json({ success: false, message: 'Internal server error retrieving patient.' });
    }
  },
  
  createPatient: async (req, res) => {
    const { name, dob, gender, phone, email, diagnosis, status } = req.body;
    const doctorId = req.user.id;

    // Validation
    if (!name || typeof name !== 'string' || name.trim() === '') {
      return res.status(400).json({ success: false, message: 'Patient name is required and must be a valid string.' });
    }
    
    // Default status if not provided
    const patientStatus = status || 'Active';

    try {
      const [result] = await db.query(
        'INSERT INTO patients (doctor_id, name, dob, gender, phone, email, diagnosis, status) VALUES (?, ?, ?, ?, ?, ?, ?, ?)',
        [doctorId, name.trim(), dob || null, gender || null, phone || null, email || null, diagnosis || null, patientStatus]
      );
      
      const newPatientId = result.insertId;
      const [newPatient] = await db.query('SELECT * FROM patients WHERE patient_id = ?', [newPatientId]);

      res.status(201).json({ 
        success: true, 
        message: 'Patient created successfully.',
        patient: newPatient[0]
      });
    } catch (error) {
      console.error('Create patient error:', error.message);
      res.status(500).json({ success: false, message: 'Internal server error creating patient.' });
    }
  },
  
  upsertPatientProfile: async (req, res) => {
    const { patient_id, name, dob, gender, phone, email, diagnosis, status } = req.body;
    const doctorId = req.user.id;
    try {
      if (patient_id) { 
        await db.query(
          'UPDATE patients SET name = ?, dob = ?, gender = ?, phone = ?, email = ?, diagnosis = ?, status = ? WHERE patient_id = ? AND doctor_id = ?',
          [name, dob, gender, phone, email, diagnosis, status, patient_id, doctorId]
        );
        res.status(200).json({ success: true, message: 'Patient profile updated successfully.' });
      } else {
        await db.query(
          'INSERT INTO patients (doctor_id, name, dob, gender, phone, email, diagnosis, status) VALUES (?, ?, ?, ?, ?, ?, ?, ?)',
          [doctorId, name, dob, gender, phone, email, diagnosis, status]
        );
        res.status(201).json({ success: true, message: 'Patient profile created successfully.' });
      }
    } catch (error) {
      console.error('Upsert patient profile error:', error.message);
      res.status(500).json({ success: false, message: 'Internal server error updating patient profile.' });
    }
  },
  
  updatePatientById: async (req, res) => {
    const { id } = req.params;
    const { name, dob, gender, phone, email, diagnosis, status } = req.body;
    const doctorId = req.user.id;

    if (!name) {
      return res.status(400).json({ success: false, message: 'Patient name is required.' });
    }

    try {
      const [result] = await db.query(
        'UPDATE patients SET name = ?, dob = ?, gender = ?, phone = ?, email = ?, diagnosis = ?, status = ? WHERE patient_id = ? AND doctor_id = ?',
        [name, dob, gender, phone, email, diagnosis, status, id, doctorId]
      );

      if (result.affectedRows === 0) {
        return res.status(404).json({ success: false, message: 'Patient not found or you do not have permission to update.' });
      }

      res.status(200).json({ success: true, message: 'Patient profile updated successfully.' });
    } catch (error) {
      console.error('Update patient by id error:', error.message);
      res.status(500).json({ success: false, message: 'Internal server error updating patient profile.' });
    }
  },
  
  deletePatientById: async (req, res) => {
    const { id } = req.params;
    const doctorId = req.user.id;

    try {
      const [result] = await db.query(
        "UPDATE patients SET status = 'deleted' WHERE patient_id = ? AND doctor_id = ?",
        [id, doctorId]
      );

      if (result.affectedRows === 0) {
        return res.status(404).json({ success: false, message: 'Patient not found or you do not have permission to delete.' });
      }

      res.status(200).json({ success: true, message: 'Patient deleted successfully.' });
    } catch (error) {
      console.error('Delete patient by id error:', error.message);
      res.status(500).json({ success: false, message: 'Internal server error deleting patient.' });
    }
  }
};


